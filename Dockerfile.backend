ARG PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_EXTRA_INDEX_URL=

COPY requirements.txt .
RUN if [ -n "$PIP_EXTRA_INDEX_URL" ]; then \
      pip install --no-cache-dir --index-url "$PIP_INDEX_URL" --extra-index-url "$PIP_EXTRA_INDEX_URL" -r requirements.txt; \
    else \
      pip install --no-cache-dir --index-url "$PIP_INDEX_URL" -r requirements.txt; \
    fi

COPY app app
COPY config config
COPY data data
COPY models models
COPY scripts scripts
COPY src src
COPY .env.example .env.example

RUN PYTHONPATH=src python models/train_classifier.py \
    && PYTHONPATH=src python scripts/build_index.py

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
