{
  "name": "xyfrag-web",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:desktop": "node ../scripts/with_desktop_env.mjs next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "build:desktop": "node ../scripts/with_desktop_env.mjs next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "start:desktop": "node ../scripts/with_desktop_env.mjs next start --hostname 127.0.0.1",
    "electron": "electron .",
    "desktop:dev": "node ../scripts/with_desktop_env.mjs electron .",
    "desktop:backend": "node ../scripts/build_desktop_backend.mjs",
    "desktop:pack": "npm run build:desktop && npm run desktop:backend && electron-builder --dir",
    "desktop:dist": "npm run build:desktop && npm run desktop:backend && electron-builder",
    "desktop:dist:mac": "npm run build:desktop && npm run desktop:backend && electron-builder --mac dmg",
    "desktop:dist:win": "node ../scripts/assert_windows_build.mjs && npm run build:desktop && npm run desktop:backend && electron-builder --win nsis",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.17.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "globals": "16.5.0",
    "jsdom": "29.1.1",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "build": {
    "appId": "cn.maverella.desktop",
    "productName": "Maverella",
    "asar": false,
    "afterPack": "build/after-pack.cjs",
    "directories": {
      "output": "dist"
    },
    "files": [
      ".next/**/*",
      "public/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      },
      {
        "from": "../",
        "to": "rag",
        "filter": [
          "desktop/backend_entry.py",
          "app/**",
          "config/**",
          "data/raw/**",
          "data/boundary/**",
          "requirements-desktop-build.txt",
          "requirements.txt",
          "requirements-local-models.txt",
          "src/**",
          "models/train_classifier.py",
          "scripts/build_index.py"
        ]
      }
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
