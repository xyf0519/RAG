ARG PYTHON_BASE_IMAGE=python:3.12-slim
FROM ${PYTHON_BASE_IMAGE}

WORKDIR /app

ENV PYTHONPATH=/app/src
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt requirements-local-models.txt ./

ARG PIP_INDEX_URL=
ARG PIP_EXTRA_INDEX_URL=
RUN python -m pip install --no-cache-dir --upgrade pip \
    && if [ -n "$PIP_INDEX_URL" ]; then \
      python -m pip install --no-cache-dir -i "$PIP_INDEX_URL" ${PIP_EXTRA_INDEX_URL:+--extra-index-url "$PIP_EXTRA_INDEX_URL"} -r requirements.txt -r requirements-local-models.txt; \
    else \
      python -m pip install --no-cache-dir ${PIP_EXTRA_INDEX_URL:+--extra-index-url "$PIP_EXTRA_INDEX_URL"} -r requirements.txt -r requirements-local-models.txt; \
    fi
