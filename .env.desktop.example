# Desktop mode template.
# Copy to `.env` for local desktop development.

APP_MODE=desktop
XYFRAG_DESKTOP=1
NEXT_PUBLIC_APP_MODE=desktop

RAG_BACKEND_URL=http://127.0.0.1:8765
AUTH_SECRET=desktop-local-session-secret
INTERNAL_API_KEY=

# The desktop app can save these through Settings. Empty values use local extractive answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Optional per-machine data locations.
XYFRAG_DATA_DIR=
XYFRAG_MODELS_DIR=
XYFRAG_LOGS_DIR=
