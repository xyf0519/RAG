# Temporary public HTTP validation profile for Aliyun ECS.
# For strict production use `.env.production` with `docker-compose.aliyun.yml`.

XYFRAG_ENV=staging

# Leave empty to use local extractive answers; set for real LLM answers.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com

# Use long random values. Do not reuse these examples.
AUTH_SECRET=replace-with-a-long-random-session-secret
INTERNAL_API_KEY=replace-with-a-long-random-internal-token

ALLOWED_EMAIL_DOMAIN=zju.edu.cn
ADMIN_EMAILS=admin@zju.edu.cn

# Temporary HTTP validation only. If SMTP is left empty, random registration
# codes are printed to backend logs instead of being delivered by email.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# HTTP by IP cannot use Secure cookies. Set true after HTTPS is configured.
SESSION_COOKIE_SECURE=false
NGINX_SERVER_NAME=_

XYFRAG_DATA_DIR=/opt/xyfrag/data
XYFRAG_MODELS_DIR=/opt/xyfrag/models
XYFRAG_LOGS_DIR=/opt/xyfrag/logs
XYFRAG_BACKUPS_DIR=/opt/xyfrag/backups

HF_TOKEN=
HF_ENDPOINT=

# Image and package mirrors for Aliyun ECS. If your server can reach Docker Hub
# and PyPI directly, these may be switched back to official upstream values.
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
BACKEND_BASE_IMAGE=rag-backend-base:latest
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:24-slim
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_EXTRA_INDEX_URL=
