# Localhost-only environment template.
# Copy to `.env` when using the `local/localhost-current` branch.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
RAG_BACKEND_URL=http://127.0.0.1:8000

AUTH_SECRET=localhost-dev-auth-secret-change-me
INTERNAL_API_KEY=localhost-internal-token-change-me
ALLOWED_EMAIL_DOMAIN=zju.edu.cn
ADMIN_EMAILS=admin@zju.edu.cn

# Local development only. Production branches must not set this.
AUTH_DEV_CODE=123456

# Optional SMTP settings. Localhost can use AUTH_DEV_CODE instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

HF_TOKEN=
HF_ENDPOINT=
