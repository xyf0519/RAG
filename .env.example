# xyfRAG API access template
# Copy this file to `.env`, then fill in your provider credentials.

# Required for real LLM calls. The backend uses an OpenAI-compatible
# `/chat/completions` API and sends this value as a Bearer token.
OPENAI_API_KEY=sk-your-api-key

# OpenAI-compatible API base URL.
# DeepSeek:
OPENAI_BASE_URL=https://api.deepseek.com
# OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# Other compatible providers:
# OPENAI_BASE_URL=https://your-provider.example.com/v1

# Backend URL used by local frontend/demo tooling.
RAG_BACKEND_URL=http://127.0.0.1:8000

# Optional: for private Hugging Face model downloads or mirror/proxy setups.
HF_TOKEN=
HF_ENDPOINT=
