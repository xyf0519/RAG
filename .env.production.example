# Production template for Aliyun ECS + Docker Compose.
# Copy to `.env.production`, fill every value, then start with:
# docker compose --env-file .env.production -f docker-compose.backend-base.yml build backend-base
# docker compose --env-file .env.production -f docker-compose.aliyun.yml up -d --build

XYFRAG_ENV=production

OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com

# Use long random values. Do not reuse the examples below.
AUTH_SECRET=replace-with-a-long-random-session-secret
INTERNAL_API_KEY=replace-with-a-long-random-internal-token

ALLOWED_EMAIL_DOMAINS=zju.edu.cn
ADMIN_EMAILS=admin@zju.edu.cn

# Production must use SMTP.
SMTP_HOST=smtp.zju.edu.cn
SMTP_PORT=994
SMTP_SECURITY=ssl
SMTP_USER=your-account@zju.edu.cn
SMTP_PASSWORD=replace-with-smtp-password-or-app-password
SMTP_FROM=your-account@zju.edu.cn

# Public host used by Nginx. Use `_` while testing by IP.
NGINX_SERVER_NAME=_

# ECS host directories for persistent data and backup jobs.
XYFRAG_DATA_DIR=/opt/xyfrag/data
XYFRAG_MODELS_DIR=/opt/xyfrag/models
XYFRAG_LOGS_DIR=/opt/xyfrag/logs
XYFRAG_BACKUPS_DIR=/opt/xyfrag/backups

HF_TOKEN=
HF_ENDPOINT=

# Image and package mirrors for Aliyun ECS. If your server can reach Docker Hub
# and PyPI directly, these may be switched back to official upstream values.
PYTHON_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
BACKEND_BASE_IMAGE=rag-backend-base:latest
NODE_BASE_IMAGE=docker.m.daocloud.io/library/node:24-slim
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
PIP_EXTRA_INDEX_URL=
